MONGODB_URI=
MONGODB_DB=lexora
AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=

# Optional password reset email (Resend)
RESEND_API_KEY=
RESET_EMAIL_FROM=Lexora <no-reply@example.com>

# Optional high-quality TTS provider. Endpoint must accept POST JSON
# { text, locale, speed } and return audio/*.
# If omitted, Lexora automatically uses browser Speech Synthesis.
TTS_PROVIDER_URL=
TTS_API_KEY=
